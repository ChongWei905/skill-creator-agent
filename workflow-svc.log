ue\': \'否\',\n        \'credit_customer\': \'是\',\n        \'small_business\': \'否\',\n        \'unsettled_loan\': \'0.0\'\n    }\n    \n    risk_level, risk_reasons = assess_risk(customer_data, parsed_info, 1000)\n    print(f"风险等级: {risk_level}")\n    print(f"风险原因: {risk_reasons}")\n    \n    # 测试中风险客户\n    print("\\n2. 测试中风险客户:")\n    parsed_info[\'potential_risk\'] = \'否\'\n    parsed_info[\'unsettled_loan\'] = \'5000.0\'\n    \n    risk_level, risk_reasons = assess_risk(customer_data, parsed_info, 1000)\n    print(f"风险等级: {risk_level}")\n    print(f"风险原因: {risk_reasons}")\n    \n    # 测试低风险客户\n    print("\\n3. 测试低风险客户:")\n    parsed_info[\'unsettled_loan\'] = \'0.0\'\n    parsed_info[\'small_business\'] = \'是\'\n    \n    risk_level, risk_reasons = assess_risk(customer_data, parsed_info, 1000)\n    print(f"风险等级: {risk_level}")\n    print(f"风险原因: {risk_reasons}")\n    \n    return True\n\n\nif __name__ == "__main__":\n    import json\n    \n    print("风险用户查询技能测试")\n    print("=" * 50)\n    \n    try:\n        # 测试解析函数\n        test_parsing_functions()\n        \n        # 测试风险评估\n        test_risk_assessment()\n        \n        print("\\n✅ 所有测试通过！")\n        \n    except Exception as e:\n        print(f"\\n❌ 测试失败: {e}")\n        sys.exit(1)'}
