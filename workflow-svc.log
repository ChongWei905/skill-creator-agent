  Tool: write_file
  Args: {'filepath': 'skills/risk-user-query/scripts/query_risk_users.py', 'content': '#!/usr/bin/env python3\n"""\n查询并分析数据库中的风险用户，生成详细的风险报告。\n\n环境变量：\n    GRAPH_DB_BASE_URL - 图数据库API端点（自动提供）\n    GRAPH_DB_TIMEOUT  - 请求超时时间（自动提供）\n\n用法：\n    python query_risk_users.py [--threshold 1000] [--output-format json|csv]\n"""\n\nimport os\nimport sys\nimport json\nimport re\nimport argparse\nfrom connectors import GraphConnector\n\n\ndef get_graph_connector():\n    """获取配置的GraphConnector实例\n    \n    从环境变量读取配置，这些变量由技能执行器自动注入。\n    """\n    base_url = os.getenv("GRAPH_DB_BASE_URL")\n    if not base_url:\n        print("错误: GRAPH_DB_BASE_URL 未设置", file=sys.stderr)\n        sys.exit(1)\n    \n    timeout = int(os.getenv("GRAPH_DB_TIMEOUT", "30"))\n    \n    return GraphConnector(base_url=base_url, timeout=timeout)\n\n\ndef parse_customer_description(description):\n    """从客户描述字段解析结构化信息\n    \n    Args:\n        description: customer_description字段内容\n        \n    Returns:\n        dict: 解析后的结构化信息\n    """\n    if not description:\n        return {}\n    \n    result = {}\n    \n    # 解析关键字段\n    patterns = {\n        \'potential_risk\': r\'潜在风险客户标识[:：]\\s*([是否])\',\n        \'overdue\': r\'逾期多次标识[:：]\\s*([是否])\',\n        \'credit_customer\': r\'授信客户标志[:：]\\s*([是否])\',\n        \'small_business\': r\'小微企业标志[:：]\\s*([是否])\',\n        \'enterprise_scale\': r\'企业规模[:：]\\s*([^。]+)\',\n        \'unsettled_loan\': r\'法人未结清贷款余额[:：]\\s*([\\d.]+)万元\',\n        \'deposit_balance\': r\'对公存款余额[:：]\\s*([\\d.]+)万元\',\n        \'financial_assets\': r\'金融资产余额[:：]\\s*([\\d.]+)万元\'\n    }\n    \n    for key, pattern in patterns.items():\n        match = re.search(pattern, description)\n        if match:\n            result[key] = match.group(1)\n    \n    return result\n\n\ndef parse_minus_data(minus_data):\n    """解析存款下降数据\n    \n    Args:\n        minus_data: minus_data字段内容\n        \n    Returns:\n        float: 存款下降金额（万元），如果没有则返回0\n    """\n    if not minus_data:\n        return 0.0\n    \n    match = re.search(r\'公司存款下降[：:]\\s*([\\d.]+)万元\', minus_data)\n    if match:\n        try:\n            return float(match.group(1))\n        except ValueError:\n            return 0.0\n    return 0.0\n\n\ndef parse_balance(balance):\n    """解析存款余额\n    \n    Args:\n        balance: balance字段内容\n        \n    Returns:\n        float: 存款余额（万元），如果没有则返回0\n    """\n    if not balance:\n        return 0.0\n    \n    match = re.search(r\'公司存款[：:]\\s*([\\d.]+)万元\', balance)\n    if match:\n        try:\n            return float(match.group(1))\n        except ValueError:\n            return 0.0\n    return 0.0\n\n\ndef assess_risk(customer_data, parsed_info, threshold):\n    """评估客户风险等级\n    \n    Args:\n        customer_data: 客户原始数据\n        parsed_info: 解析后的结构化信息\n        threshold: 高风险阈值（万元）\n        \n    Returns:\n        tuple: (风险等级, 风险原因)\n    """\n    risk_reasons = []\n    \n    # 检查高风险标识\n    if parsed_info.get(\'potential_risk\') == \'是\':\n        risk_reasons.append("潜在风险客户标识=是")\n    \n    if parsed_info.get(\'overdue\') == \'是\':\n        risk_reasons.append("逾期多次标识=是")\n    \n    if risk_reasons:\n        return "高风险", risk_reasons\n    \n    # 检查中风险标识\n    if parsed_info.get(\'credit_customer\') == \'是\':\n        try:\n            unsettled_loan = float(parsed_info.get(\'unsettled_loan\', 0))\n            if unsettled_loan > threshold:\n                risk_reasons.append(f"授信客户且未结清贷款余额高({unsettled_loan}万元)")\n        except (ValueError, TypeError):\n            pass\n    \n    # 检查存款下降\n    minus_amount = parse_minus_data(customer_data.get(\'minus_data\', \'\'))\n    if minus_amount > 1000:  # 下降超过1000万元\n        risk_reasons.append(f"存款大幅下降({minus_amount}万元)")\n    \n    if risk_reasons:\n        return "中风险", risk_reasons\n    \n    # 检查低风险标识\n    if parsed_info.get(\'small_business\') == \'是\':\n        risk_reasons.append("小微企业")\n    \n    minus_amount = parse_minus_data(customer_data.get(\'minus_data\', \'\'))\n    if 0 < minus_amount <= 500:  # 小幅下降\n        risk_reasons.append(f"存款小幅下降({minus_amount}万元)")\n    \n    if risk_reasons:\n        return "低风险", risk_reasons\n    \n    return "正常", ["无明显风险标识"]\n\n\ndef generate_report(customers, threshold, output_format=\'json\'):\n    """生成风险报告\n    \n    Args:\n        customers: 客户数据列表\n        threshold: 高风险阈值\n        output_format: 输出格式\n        \n    Returns:\n        dict: 风险报告\n    """\n    report = {\n        "summary": {\n            "total_customers": len(customers),\n            "high_risk_count": 0,\n            "medium_risk_count": 0,\n            "low_risk_count": 0,\n            "normal_customers": 0\n        },\n        "high_risk_customers": [],\n        "medium_risk_customers": [],\n        "low_risk_customers": [],\n        "analysis": {}\n    }\n    \n    for customer in customers:\n        # 解析客户信息\n        parsed_info = parse_customer_description(customer.get(\'customer_description\', \'\'))\n        balance = parse_balance(customer.get(\'balance\', \'\'))\n        minus_amount = parse_minus_data(customer.get(\'minus_data\', \'\'))\n        \n        # 评估风险\n        risk_level, risk_reasons = assess_risk(customer, parsed_info, threshold)\n        \n        # 构建客户信息\n        customer_info = {\n            "name": customer.get(\'name\', \'未知\'),\n            "party_id": customer.get(\'party_id\', \'未知\'),\n            "organ_code": customer.get(\'organ_code\', \'未知\'),\n            "balance": f"{balance}万元",\n            "minus_data": f"{minus_amount}万元",\n            "risk_level": risk_level,\n            "risk_reasons": risk_reasons,\n            "parsed_info": parsed_info\n        }\n        \n        # 分类统计\n        if risk_level == "高风险":\n            report["summary"]["high_risk_count"] += 1\n            report["high_risk_customers"].append(customer_info)\n        elif risk_level == "中风险":\n            report["summary"]["medium_risk_count"] += 1\n            report["medium_risk_customers"].append(customer_info)\n        elif risk_level == "低风险":\n            report["summary"]["low_risk_count"] += 1\n            report["low_risk_customers"].append(customer_info)\n        else:\n            report["summary"]["normal_customers"] += 1\n    \n    # 生成分析\n    total = report["summary"]["total_customers"]\n    if total > 0:\n        report["analysis"] = {\n            "risk_distribution": {\n                "high_risk_percentage": round(report["summary"]["high_risk_count"] / total * 100, 1),\n                "medium_risk_percentage": round(report["summary"]["medium_risk_count"] / total * 100, 1),\n                "low_risk_percentage": round(report["summary"]["low_risk_count"] / total * 100, 1),\n                "normal_percentage": round(report["summary"]["normal_customers"] / total * 100, 1)\n            },\n            "top_risk_factors": ["潜在风险标识", "逾期记录", "高额未结清贷款", "存款大幅下降"],\n            "recommendations": [\n                "重点关注高风险客户，进行深入调查",\n                "定期监控中风险客户的财务状况",\n                "为低风险客户提供增值服务以增强客户粘性"\n            ],\n            "threshold_used": f"{threshold}万元"\n        }\n    \n    return report\n\n\ndef main():\n    parser = argparse.ArgumentParser(description="查询数据库中的风险用户")\n    parser.add_argument("--threshold", type=float, default=1000.0,\n                       help="高风险阈值（万元），默认1000")\n    parser.add_argument("--output-format", choices=[\'json\', \'csv\'], default=\'json\',\n                       help="输出格式，默认json")\n    \n    args = parser.parse_args()\n    \n    try:\n        # 获取图数据库连接器\n        connector = get_graph_connector()\n        \n        print(f"正在查询数据库中的客户数据...", file=sys.stderr)\n        \n        # 查询所有Person实体\n        customers = connector.property_filter(\n            element_class="Person",\n            element_type="NODE",\n            filter_dict={},\n            get_all_properties=True\n        )\n        \n        if not customers:\n            print("数据库中没有找到客户数据", file=sys.stderr)\n            sys.exit(0)\n        \n        print(f"找到 {len(customers)} 个客户记录", file=sys.stderr)\n        \n        # 生成风险报告\n        report = generate_report(customers, args.threshold, args.output_format)\n        \n        # 输出结果\n        if args.output_format == \'json\':\n            print(json.dumps(report, ensure_ascii=False, indent=2))\n        else:\n            # CSV格式输出（简化版）\n            print("客户名称,客户ID,机构代码,风险等级,存款余额,存款下降,风险原因")\n            for risk_level, customers_list in [\n                ("高风险", report["high_risk_customers"]),\n                ("中风险", report["medium_risk_customers"]),\n                ("低风险", report["low_risk_customers"])\n            ]:\n                for customer in customers_list:\n                    risk_reasons = "; ".join(customer["risk_reasons"])\n                    print(f\'{customer["name"]},{customer["party_id"]},{customer["organ_code"]},\'\n                          f\'{risk_level},{customer["balance"]},{customer["minus_data"]},\'\n                          f\'"{risk_reasons}"\')\n        \n    except Exception as e:\n        print(f"错误: {e}", file=sys.stderr)\n        sys.exit(1)\n\n\nif __name__ == "__main__":\n    main()'}
