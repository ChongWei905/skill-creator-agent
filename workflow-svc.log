  Args: {'filepath': 'skills/risk-user-query/scripts/get_high_risk_users.py', 'content': '#!/usr/bin/env python3\n"""\n专门查询高风险用户。\n\n环境变量：\n    GRAPH_DB_BASE_URL - 图数据库API端点（自动提供）\n    GRAPH_DB_TIMEOUT  - 请求超时时间（自动提供）\n\n用法：\n    python get_high_risk_users.py [--limit 10]\n"""\n\nimport os\nimport sys\nimport json\nimport re\nimport argparse\nfrom connectors import GraphConnector\n\n\ndef get_graph_connector():\n    """获取配置的GraphConnector实例"""\n    base_url = os.getenv("GRAPH_DB_BASE_URL")\n    if not base_url:\n        print("错误: GRAPH_DB_BASE_URL 未设置", file=sys.stderr)\n        sys.exit(1)\n    \n    timeout = int(os.getenv("GRAPH_DB_TIMEOUT", "30"))\n    \n    return GraphConnector(base_url=base_url, timeout=timeout)\n\n\ndef is_high_risk_customer(customer):\n    """判断是否为高风险客户\n    \n    Args:\n        customer: 客户数据\n        \n    Returns:\n        tuple: (是否为高风险, 风险原因)\n    """\n    customer_description = customer.get(\'customer_description\', \'\')\n    \n    # 检查潜在风险标识\n    if re.search(r\'潜在风险客户标识[:：]\\s*是\', customer_description):\n        return True, "潜在风险客户标识=是"\n    \n    # 检查逾期多次标识\n    if re.search(r\'逾期多次标识[:：]\\s*是\', customer_description):\n        return True, "逾期多次标识=是"\n    \n    return False, ""\n\n\ndef parse_financial_info(customer):\n    """解析财务信息\n    \n    Args:\n        customer: 客户数据\n        \n    Returns:\n        dict: 财务信息\n    """\n    result = {}\n    \n    # 解析存款余额\n    balance = customer.get(\'balance\', \'\')\n    if balance:\n        match = re.search(r\'公司存款[：:]\\s*([\\d.]+)万元\', balance)\n        if match:\n            result[\'balance\'] = float(match.group(1))\n    \n    # 解析存款下降\n    minus_data = customer.get(\'minus_data\', \'\')\n    if minus_data:\n        match = re.search(r\'公司存款下降[：:]\\s*([\\d.]+)万元\', minus_data)\n        if match:\n            result[\'minus_amount\'] = float(match.group(1))\n    \n    # 解析未结清贷款\n    description = customer.get(\'customer_description\', \'\')\n    if description:\n        match = re.search(r\'法人未结清贷款余额[:：]\\s*([\\d.]+)万元\', description)\n        if match:\n            result[\'unsettled_loan\'] = float(match.group(1))\n    \n    return result\n\n\ndef get_high_risk_users(limit=None):\n    """获取高风险用户\n    \n    Args:\n        limit: 返回结果数量限制\n        \n    Returns:\n        list: 高风险用户列表\n    """\n    try:\n        connector = get_graph_connector()\n        \n        # 查询所有Person实体\n        customers = connector.property_filter(\n            element_class="Person",\n            element_type="NODE",\n            filter_dict={},\n            get_all_properties=True\n        )\n        \n        if not customers:\n            return []\n        \n        # 筛选高风险用户\n        high_risk_users = []\n        for customer in customers:\n            is_high_risk, risk_reason = is_high_risk_customer(customer)\n            if is_high_risk:\n                # 解析财务信息\n                financial_info = parse_financial_info(customer)\n                \n                # 构建用户信息\n                user_info = {\n                    "name": customer.get(\'name\', \'未知\'),\n                    "party_id": customer.get(\'party_id\', \'未知\'),\n                    "organ_code": customer.get(\'organ_code\', \'未知\'),\n                    "risk_reason": risk_reason,\n                    "financial_info": financial_info,\n                    "customer_description": customer.get(\'customer_description\', \'\')[:200] + "..." if len(customer.get(\'customer_description\', \'\')) > 200 else customer.get(\'customer_description\', \'\')\n                }\n                \n                high_risk_users.append(user_info)\n                \n                # 如果有限制，检查是否达到限制\n                if limit and len(high_risk_users) >= limit:\n                    break\n        \n        return high_risk_users\n        \n    except Exception as e:\n        print(f"查询错误: {e}", file=sys.stderr)\n        return []\n\n\ndef main():\n    parser = argparse.ArgumentParser(description="查询高风险用户")\n    parser.add_argument("--limit", type=int, default=None,\n                       help="返回结果数量限制")\n    \n    args = parser.parse_args()\n    \n    print(f"正在查询高风险用户...", file=sys.stderr)\n    \n    high_risk_users = get_high_risk_users(args.limit)\n    \n    if not high_risk_users:\n        print("未找到高风险用户", file=sys.stderr)\n        sys.exit(0)\n    \n    # 输出结果\n    result = {\n        "total_high_risk_users": len(high_risk_users),\n        "high_risk_users": high_risk_users,\n        "summary": {\n            "by_risk_reason": {},\n            "by_organ_code": {}\n        }\n    }\n    \n    # 统计信息\n    for user in high_risk_users:\n        # 按风险原因统计\n        reason = user["risk_reason"]\n        result["summary"]["by_risk_reason"][reason] = result["summary"]["by_risk_reason"].get(reason, 0) + 1\n        \n        # 按机构代码统计\n        organ_code = user["organ_code"]\n        result["summary"]["by_organ_code"][organ_code] = result["summary"]["by_organ_code"].get(organ_code, 0) + 1\n    \n    print(json.dumps(result, ensure_ascii=False, indent=2))\n\n\nif __name__ == "__main__":\n    main()'}
